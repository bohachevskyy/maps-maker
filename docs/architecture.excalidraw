   "updated": 1,
   "link": null,
   "locked": false,
   "text": "overlays/ — features above the basemap\nusgs      earthquake query grammar\noverpass  any OSM tag (validated by taginfo),\n          route relations, settlements,\n          300 s budget, stale cache,\n          Overture fallback\nweb       10-entry curated catalogue\n          + any https CSV/GeoJSON URL\n          (service fetches + validates)\ncoast · geo  coastline · route km",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "re029",
   "originalText": "overlays/ — features above the basemap\nusgs      earthquake query grammar\noverpass  any OSM tag (validated by taginfo),\n          route relations, settlements,\n          300 s budget, stale cache,\n          Overture fallback\nweb       10-entry curated catalogue\n          + any https CSV/GeoJSON URL\n          (service fetches + validates)\ncoast · geo  coastline · route km",
   "autoResize": true,
   "lineHeight": 1.25
