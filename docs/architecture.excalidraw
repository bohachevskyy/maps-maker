   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "statistics/ — values, keyed the same way\nsearchable: owid · eurostat · eia\nfixed: census_acs · bls · elections (MIT)\n       statcan · ukrstat · wikidata\n       natural_earth\nregions.py  UN M49 + EU27 + informal\nkatotth.py  Ukraine settlement codifier\n\nrules: official over Wikidata; stale or\nmixed-year series -> repair; count/count -> %",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "re027",
   "originalText": "statistics/ — values, keyed the same way\nsearchable: owid · eurostat · eia\nfixed: census_acs · bls · elections (MIT)\n       statcan · ukrstat · wikidata\n       natural_earth\nregions.py  UN M49 + EU27 + informal\nkatotth.py  Ukraine settlement codifier\n\nrules: official over Wikidata; stale or\nmixed-year series -> repair; count/count -> %",
   "autoResize": true,
   "lineHeight": 1.25
  },
